// A harness, written in sic: a model call whose answer is validated, a retry
// when it is not good enough, a budget that bounds the whole thing, a person
// at the point that changes something, and a record that can be re-run.
//
// `docs/design/harness.md` is what this program is evidence for, and every
// gap it hit is a section of that document rather than a workaround hidden
// here.
//
//     sic plan workflows/harness.sic
//     sic run  workflows/harness.sic --record
//     sic attach <ID> --value '{"file":"...","change":"...","confidence":90}'
//     sic explain <ID>
//     sic recheck <ID> workflows/harness.sic
//
// **Every path in the `allow` block is a placeholder**, for the reason
// `workflows/ci.sic` gives at length: a manifest names files on one machine.
// `.gitignore` has `workflows/*.local.sic` for the copy with yours in it.
type Fix {
    file: String,
    change: String,
    // Per cent, and an `Int` rather than the `Float` every other agent in this
    // repository declares a confidence as. That was forced until #85 gave
    // `Float` its ordering; it is a choice about the question now.
    confidence: Int,
}

allow {
    process.run "/PATH/TO/build" in "/PATH/TO/project";
    // `repeatable` is what lets the agent below declare a `retry`: asking again
    // is a second model call, and a second call of anything needs the manifest
    // to say performing it twice is allowed.
    llm.invoke "claude-opus-4" repeatable;
    human.approve "applying the fix";
    process.exec "/PATH/TO/apply";
}

// The numbers a harness is bounded by, in the place a reader of the program
// meets them. They are separate fields because they are enforced in different
// places (`docs/design/authority.md` §8), and they are on the declaration
// rather than at a call site because a bound a person approves must not depend
// on how many places call the thing it is written on.
//
// The two retries are the two things that go wrong with a model, and only one
// of them is a number here. `retry` is the runtime's: the answer did not fit
// `Fix` at all. The loop below is the program's: the answer fit and the program
// did not like it.
agent propose {
    input: String,
    output: Fix,
    budget: 3,          // model calls in a run, enforced by the VM
    retry: 3,           // attempts at an answer that fits `Fix`, by the VM
    tools: 8,           // tool uses, enforced by the broker through the hook
    deadline: 120000,   // per answer, enforced by the broker
    memory: task,       // one conversation, so a retry needs no prompt
}

fn build() -> Exit {
    return process.run("/PATH/TO/build", []);
}

// The *semantic* retry: the answer fit `Fix` and the program does not like it.
// This one has to be written, because the judgement is the program's - the
// runtime has no opinion about what a confidence of 40 means. It is a recursion
// because nothing in the language assigns.
//
// The shape retry is not here and never was: an answer that is not `Fix` at all
// never reaches this function, because `retry: 3` on the declaration has the VM
// ask again before the value exists. That is #83, and `harness.md` §5.1 is the
// finding it came from.
//
// The literal prompt is the other half of that section. The logs are
// `Observed<String>` and the answer is `LLM<String>`, and `+` refuses to join
// two provenances (E0375, and it is right to), so the program cannot quote the
// answer it is rejecting. `memory: task` is what makes a literal enough: the
// second call is asked in a conversation that already holds the first answer.
fn propose_until_confident(logs: Observed<String>) -> LLM<Fix> {
    let f = propose(logs);
    if f.confidence > 70 {
        return f;
    }
    return retry_proposal(2);
}

fn retry_proposal(tries: Int) -> LLM<Fix> {
    let f = propose("that answer was not confident enough. Try again.");
    if f.confidence > 70 {
        return f;
    }
    if tries <= 1 {
        // Out of tries, and the last answer is what there is. A harness that
        // wanted to give up here rather than carry on has nothing to say so
        // with: a failure is not a value in this language.
        return f;
    }
    return retry_proposal(tries - 1);
}

// The point that changes something, and the only way to reach it. Passing the
// model's answer straight to this does not compile.
fn apply(fix: HumanApproved<Fix>) -> Int {
    return process.exec("/PATH/TO/apply");
}

fn main() -> Int {
    let r = build();
    if r.code == 0 {
        log info "nothing to fix";
        return 0;
    }
    log warn "the build failed, asking for a fix";
    let fix = propose_until_confident(r.output);
    log info "proposed: " + fix.change;
    let approved = approve("apply this fix?", fix);
    return apply(approved);
}
