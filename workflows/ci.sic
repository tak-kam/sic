// The development loop of this repository, as a sic program.
//
// This is issue #8: whether sic can be used to build sic. What the attempt
// established, and the seven things that bent it, are in
// `docs/design/self-hosting.md`. Two of them are fixed: #50 gave the language
// `process.run`, so this program no longer has to grant itself a shell to see
// why a build failed, and #49 followed from that.
//
//     sic plan workflows/ci.sic
//     sic run workflows/ci.sic --record
//
// The cargo path is one machine's. `sic` searches no `PATH` by design
// (`docs/design/capabilities.md`), so a grant names a file rather than a
// command, and a workflow does not move between machines unedited. That is a
// consequence of a security property rather than a defect, and it is written
// down rather than worked around.
type Diagnosis {
    cause: String,
    file: String,
    confidence: Float,
}

allow {
    process.run "/PATH/TO/cargo-bin/cargo" args ["test"];
    llm.invoke "claude-opus-4";
}

agent diagnose {
    input: String,
    output: Diagnosis,
    budget: 1,
}

// `process.run` answers with both facts: the code the program exited with and
// what it printed. That is what makes this workflow writable at all - a test
// suite that fails is the entire reason to run one, and until #50 the failure
// took the output with it. See `docs/design/output.md` §9.
//
// The grant names `cargo` rather than a shell, which is what #50 bought. And it
// does not say `delegable`, so the agent answering the model call below is not
// offered it: the agent's job here is to read test output, not to run the
// tests again. `sic plan` says so on its own line. See #49 and
// `docs/design/authority.md` §4a.
fn tests() -> Exit {
    return process.run("/PATH/TO/cargo-bin/cargo", ["test", "--workspace", "--target", "x86_64-unknown-linux-musl"]);
}

fn main() -> Observed<String> {
    let r = tests();
    if r.code == 0 {
        // Nothing to diagnose. The agent is not asked and the budget is not
        // spent, which is what `sic plan` means by "at most 1".
        return r.output;
    }
    // The diagnosis goes into the run's record rather than into this value:
    // `sic explain` shows what the agent was asked and what it answered. A
    // program has nowhere else to put it, because a model's answer is
    // `LLM<String>` and this function has already promised a different type -
    // and because §26, logging, is unbuilt. See `docs/design/self-hosting.md`.
    let d = diagnose(r.output);
    return r.output;
}
