// The development loop of this repository, as a sic program.
//
// This is issue #8: whether sic can be used to build sic. What the attempt
// established, and the seven things that bent it, are in
// `docs/design/self-hosting.md`. Most of them are fixed: #50 gave the language
// `process.run`, so this program no longer has to grant itself a shell to see
// why a build failed; #49 followed from that; #51 let the grant say what
// directory and environment a call gets, which is what makes the `RUSTFLAGS`
// line below possible; and #58 gave the diagnosis somewhere to go.
//
//     sic plan workflows/ci.sic
//     sic run workflows/ci.sic --record
//
// **Every path in the `allow` block below is a placeholder.** Copy this file,
// put your own in, and keep the copy out of the repository - `.gitignore` has
// `workflows/*.local.sic` for exactly that.
//
// That is the shape rather than a shortcut. `sic` searches no `PATH` by design,
// so a grant names a file rather than a command; `in` and `env` name the rest
// of what a child depends on for the same reason (#51). The result is a
// manifest a reader can check against the machine in front of them, and a
// workflow that does not move between machines unedited.
//
// There is deliberately no way to write "read this from the environment". A
// manifest that deferred to a variable would be handing back the decision `sic`
// spent `in` and `env` taking: what runs would again be decided by whatever the
// shell had set, which is the thing `env_clear` is there to stop. So the paths
// are in the open, and the copy with your machine's in it is yours.
//
// The `RUSTFLAGS` line is this repository's own documented workaround for a
// machine with no C linker (`CLAUDE.md`, "Building"). Before #51 it could not
// be written: a capability call was given no environment and there was no way
// to say what it needed.
type Diagnosis {
    cause: String,
    file: String,
    confidence: Float,
}

allow {
    // What this run is about. The constraint names git the way every grant
    // that starts a program does, and `in` names the repository - and the
    // broker turns off every hook, pager, alias and config file it did not put
    // there, which is what a `process.run "/PATH/TO/git"` grant could not say.
    // See `docs/design/git.md`.
    git.rev_parse "/PATH/TO/git" in "/PATH/TO/sic";
    git.status "/PATH/TO/git" in "/PATH/TO/sic";
    process.run "/PATH/TO/cargo" args ["test"]
        in "/PATH/TO/sic"
        env {
            PATH: "/PATH/TO/cargo-bin:/usr/bin:/bin",
            HOME: "/PATH/TO/home",
            // A backslash at the end of a line joins it to the next and eats
            // the indentation, which is #53. With a real toolchain path this
            // line is 171 characters.
            RUSTFLAGS: "-Clinker=/PATH/TO/rustup/toolchains/\
                        stable-x86_64-unknown-linux-gnu/lib/rustlib/\
                        x86_64-unknown-linux-gnu/bin/rust-lld \
                        -Clinker-flavor=ld.lld",
        };
    llm.invoke "claude-opus-4";
}

agent diagnose {
    input: String,
    output: Diagnosis,
    budget: 1,
}

// `process.run` answers with both facts: the code the program exited with and
// what it printed. That is what makes this workflow writable at all - a test
// suite that fails is the entire reason to run one, and until #50 the failure
// took the output with it. See `docs/design/output.md` §9.
//
// The grant names `cargo` rather than a shell, which is what #50 bought. And it
// does not say `delegable`, so the agent answering the model call below is not
// offered it: the agent's job here is to read test output, not to run the
// tests again. `sic plan` says so on its own line. See #49 and
// `docs/design/authority.md` §4a.
fn tests() -> Exit {
    return process.run(
        "/PATH/TO/cargo",
        ["test", "--workspace", "--target", "x86_64-unknown-linux-musl"],
    );
}

// A test result that is not tied to a state of the repository is a fact about
// nothing. This puts both halves of that state in the journal before anything
// runs, so `sic explain` on a recorded run says which commit it was about and
// how much was not in it.
//
// It reports rather than refuses. A tree with uncommitted work in it is the
// normal case while somebody is working, and a workflow that stopped there
// would be refusing to test the thing it was written to test.
// A test result that is not tied to a state of the repository is a fact about
// nothing. This puts both halves of that state in the journal before anything
// runs, so `sic explain` on a recorded run says which commit it was about and
// what was not in it.
//
// It names the files rather than counting them, which is what #66 bought. A
// count answers "is this a test of HEAD"; the names answer "of what, then",
// and that is the question somebody reading the record a week later has.
//
// It reports rather than refuses. A tree with uncommitted work in it is the
// normal case while somebody is working, and a workflow that stopped there
// would be refusing to test the thing it was written to test.
fn what_is_being_tested() -> Int {
    log info "testing " + git.rev_parse("HEAD");
    let dirty = git.status();
    for entry in dirty {
        log warn "not committed: " + entry;
    }
    return len(dirty);
}

// A build that did not compile and a test that failed are different failures,
// and until #68 this program could not tell them apart - it held everything
// cargo printed and could answer one question about it, how long it was.
//
// The string is cargo's own, and the workflow is pinned to it: if that wording
// changes the branch goes the other way and the diagnosis says so rather than
// silently becoming wrong. That is worth saying out loud, because a workflow
// that matches on another program's output has taken on a dependency the
// manifest cannot express.
fn ran_but_failed(output: Observed<String>) -> Bool {
    return contains(output, "test result: FAILED");
}

fn main() -> Observed<String> {
    let uncommitted = what_is_being_tested();
    if uncommitted > 0 {
        log warn "this is not a test of HEAD";
    }
    log info "running the tests";
    let r = tests();
    if r.code == 0 {
        // Nothing to diagnose. The agent is not asked and the budget is not
        // spent, which is what `sic plan` means by "at most 1".
        log info "they passed";
        return r.output;
    }
    // Which of the two failures it was decides what the agent is asked. Asking
    // "why did these tests fail" about output that is a compiler error wastes
    // the one model call this program is budgeted for, on a question whose
    // premise is false.
    if ran_but_failed(r.output) {
        log warn "tests failed, asking the agent why";
    } else {
        log warn "it did not build, asking the agent why";
    }
    let d = diagnose(r.output);
    // This is what #58 was for. The binding used to go nowhere: a model's
    // answer is `LLM<String>` and this function had already promised a
    // different type, so the diagnosis had no channel out of the program.
    log error d.cause;
    return r.output;
}
