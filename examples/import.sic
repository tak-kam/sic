// A program built from two files.
//
// The grant lives here, in the file that is run: `lib/deploy.sic` states that
// it needs `process.exec`, and this file decides which binary that means. Run
// `sic plan examples/import.sic` to see both halves in one manifest.

import "./lib/deploy.sic";

allow {
    // `repeatable` is this file's claim, not the library's: `lib/deploy.sic`
    // asks to retry, and the file that decides which binary that means is the
    // only one that can say whether running it twice is the same as running it
    // once. Running `/bin/echo` twice is.
    process.exec "/bin/echo" repeatable;
}

fn main() -> Bool {
    return deploy("/bin/echo");
}
