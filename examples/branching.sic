// `&&` and `||` only evaluate their right-hand side when it can change the
// answer, so they lower to branches rather than to an instruction.
fn classify(n: Int) -> Int {
    if n < 0 {
        return -1;
    } else if n == 0 {
        return 0;
    }
    return 1;
}

fn in_range(n: Int, lo: Int, hi: Int) -> Bool {
    return n >= lo && n <= hi;
}

fn main() {
    if in_range(7, 1, 10) {
        return classify(7);
    }
    return classify(-7);
}
